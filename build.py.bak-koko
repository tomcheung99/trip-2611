   ("13:35", "KANNON COFFEE 大須店", "KANNON COFFEE 大須店", "11:00-19:00．大須 2-17-25", False),
   ("14:10", "回名古屋駅", "名古屋駅", "取行李、最後採購", False),
   ("15:30", "名鉄 μ-SKY", None, "28 分 ¥1,430", True),
   ("16:00", "中部國際空港 T2", "中部国際空港", "香水未寄艙：先過海關確認再寄行李（リファンド方式），過關後無得搞", False),
   ("20:40", "UO685 起飛", None, "4 小時 50 分", True),
   ("00:30+1", "香港國際機場 T1", "香港國際機場", "11/30 凌晨抵港", False),
 ]),

]

def flow_panel(key, date, wd, title, items):
    nodes = []
    for t, place, q, note, is_move in items:
        cls = "move" if is_move else "stop"
        name = L(place, q) if q else place
        tl = f'<div class="t">{t}</div>' if t else '<div class="t"></div>'
        nodes.append(
f"""      <div class="node {cls}">
        {tl}
        <div class="rail"><span class="dot"></span></div>
        <div class="body"><div class="{'leg' if is_move else 'place'}">{name}</div>
          <div class="fnote">{note}</div></div>
      </div>""")
    return (f'  <section class="day" id="day{key}" data-day="{key}" hidden>\n'
            f'    <p class="daytitle">{date}（{wd}）<span>{title}</span></p>\n'
            f'    <div class="flow">\n' + "\n".join(nodes) + "\n    </div>\n  </section>")

rows = []
for d, wd, base, plan, leg, _ in DAYS:
    rows.append(f"""    <tr>
      <td class="date">{d}<span>{wd}</span></td>
      <td class="base">{base}</td>
      <td class="plan">{plan}</td>
      <td class="leg">{leg}</td>
    </tr>""")

hrows = []
for city, n, area, pick, q in HOTELS:
    hrows.append(f"""    <tr><td class="base">{city}</td><td>{n}</td><td>{L(area, q)}</td><td class="leg">{pick}</td></tr>""")

tabs = "\n".join(f'    <button class="tab" type="button" data-day="{k}">{d}<span>{w}</span></button>'
                 for k, d, w, _, _ in FLOW)
panels = "\n".join(flow_panel(*f) for f in FLOW)

TPL = pathlib.Path(__file__).with_name("template.html").read_text(encoding="utf-8")
out = (TPL.replace("{{ROWS}}", "\n".join(rows))
          .replace("{{HOTEL_ROWS}}", "\n".join(hrows))
          .replace("{{TABS}}", tabs)
          .replace("{{PANELS}}", panels))
pathlib.Path(__file__).with_name("index.html").write_text(out, encoding="utf-8")
print("wrote index.html", len(out), "bytes")
