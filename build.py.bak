"""產生行程表 HTML（Google Maps 連結 + 逐日流程圖 tabs）"""
import urllib.parse, pathlib

def m(q):
    return "https://www.google.com/maps/search/?api=1&query=" + urllib.parse.quote(q)

def L(text, q):
    return f'<a class="map" href="{m(q)}" target="_blank" rel="noopener">{text}</a>'

